# Grand Theft Chog. install-config.sh puts the first name from PUBLIC_HOST here (/etc/chog-city/app.env)
# and adds a redirect from every other name to it, so an old address keeps working after a move.
__MAIN__ {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Chog images, pre-sized and keyed by token ID. They never change.
	handle_path /img/* {
		root * /srv/chog-city/images
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The site's fixed files, straight from disk instead of through the web app, which serves one request at a
	# time and compressed every file again for every visitor (30 people arriving at once took it to 90% CPU).
	# Compressed once at deploy (deploy/precompress.sh). Same caching as before: code files keep their name
	# only as long as their content (a year), stickers carry a version, the rest is checked on each visit.
	handle_path /_next/static/* {
		root * /opt/chog-city/current/apps/web/.next/standalone/apps/web/.next/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed zstd gzip
		}
	}
	handle /art/stickers/* {
		root * /opt/chog-city/current/apps/web/.next/standalone/apps/web/public
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	@public path /art/* /emotes/* /fonts/* /music/*
	handle @public {
		root * /opt/chog-city/current/apps/web/.next/standalone/apps/web/public
		header Cache-Control "public, max-age=0"
		file_server {
			precompressed zstd gzip
		}
	}

	# The live city (WebSocket).
	handle /ws {
		reverse_proxy 127.0.0.1:3001
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}

	# The few seconds the app restarts on a deploy: a page that tries again by itself, not a blank screen.
	handle_errors 502 503 504 {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-store"
		header Retry-After "3"
		respond <<HTML
			<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
			<title>Grand Theft Chog</title><meta http-equiv="refresh" content="3">
			<style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#0b0918;color:#fff;font:600 17px -apple-system,system-ui,sans-serif;text-align:center}p{color:#a59fc9;font-weight:500;font-size:15px}</style></head>
			<body><div><div style="font-size:26px;font-weight:800">Grand Theft Chog is updating</div><p>Back in a few seconds. This page tries again by itself.</p></div></body></html>
			HTML 503
	}
}
