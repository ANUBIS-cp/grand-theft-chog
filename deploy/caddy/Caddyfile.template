# Chog World. install-config.sh puts the first name from PUBLIC_HOST here (/etc/chog-city/app.env)
# and adds a redirect from every other name to it, so an old address keeps working after a move.
__MAIN__ {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Chog images, pre-sized and keyed by token ID. They never change.
	handle_path /img/* {
		root * /srv/chog-city/images
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The live city (WebSocket).
	handle /ws {
		reverse_proxy 127.0.0.1:3001
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
