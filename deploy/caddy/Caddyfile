# Chog City. Add the DuckDNS name next to the sslip.io one when it exists: "a.sslip.io, b.duckdns.org {".
chogcity.35-212-31-75.sslip.io {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Chog images, pre-sized and keyed by token ID. They never change.
	handle_path /img/* {
		root * /srv/chog-city/images
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
